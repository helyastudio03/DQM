{
  "name": "SalesDashboard",
  "dataColors": [
    "#2f6fb0",
    "#2e8b57",
    "#c0563f",
    "#7a6cc0",
    "#9a9a93",
    "#cfd8e6",
    "#2b2b33",
    "#b9b7ac"
  ],
  "background": "#fffefa",
  "foreground": "#2b2b33",
  "tableAccent": "#2f6fb0",
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#fffefa" } } }],
        "fontFamily": [{ "value": "Segoe UI" }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{
          "color": { "solid": { "color": "#2b2b33" } },
          "fontSize": 36
        }],
        "categoryLabel": [{
          "color": { "solid": { "color": "#5a5a62" } },
          "fontSize": 11
        }],
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#ffffff" } },
          "transparency": 0
        }]
      }
    },
    "gauge": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#2f6fb0" } } }]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#cfd8e6" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#cfd8e6" } } }]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#cfd8e6" } } }]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#2f6fb0" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "rowPadding": 6,
          "outlineColor": { "solid": { "color": "#b9b7ac" } },
          "gridVertical": false
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#5a5a62" } },
          "backColor": { "solid": { "color": "#faf8ee" } },
          "fontSize": 11
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#2b2b33" } },
          "fontSize": 12
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#2b2b33" } },
          "backColor": { "solid": { "color": "#faf8ee" } },
          "fontSize": 12
        }]
      }
    },
    "slicer": {
      "*": {
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#ffffff" } },
          "transparency": 0
        }]
      }
    }
  }
}
